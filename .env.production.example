# ==============================================================================
# ChangeRadar 1.0 — Production Environment Configuration Template
# Copy this file to .env.production and provide production credentials.
# ==============================================================================

# Node / Python Environment
ENVIRONMENT=production

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=changeradar
POSTGRES_USER=changeradar_admin
POSTGRES_PASSWORD=replace_with_a_cryptographically_secure_password_at_least_32_chars
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://changeradar_admin:replace_with_a_cryptographically_secure_password_at_least_32_chars@postgres:5432/changeradar

# Symmetric Encryption Key for Sensitive Secrets (Fernet key - base64 encoded 32 bytes)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_generated_fernet_key_base64_encoded

# HTTP Session Security
COOKIE_SECURE=true
CORS_ORIGINS=https://changeradar.yourcompany.com

# GitHub Integration (OAuth App or GitHub App)
# Optional: Can be configured at system level or connected per-user via Personal Access Tokens
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=replace_with_high_entropy_webhook_hmac_secret

# Storage and Resource Quotas
REPO_STORAGE_DIR=/app/storage/repositories
BACKGROUND_WORKER_CONCURRENCY=4
ANALYSIS_ENGINE_VERSION=1.0.0
